	# 	new_pack.append(i)
	# len(new_pack)
	
	new_pack = packs
	temp = packs[0]
	temp = temp + temp[6:17]
	packs[0] = temp
	print("shit", len(packs[0]))
	print("testing", len(packs))
	packs = packs * 50 
