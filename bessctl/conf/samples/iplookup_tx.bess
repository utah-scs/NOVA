# Simple IPv4 LPM example. Try tcpdump on each output gate of 'ipfwd'.
#
import scapy.all as scapy

def gen_packet(dst_ip):
    # eth = scapy.Ether(src='00:8C:FA:F7:19:38', dst='00:8C:FA:F7:19:3E')
    eth = scapy.Ether(src='1c:34:da:41:d2:94', dst='1c:34:da:41:cb:94')
    # eth = scapy.Ether(src='1c:34:da:41:d2:95', dst='1c:34:da:41:cb:95')
    ip = scapy.IP(src='1.2.3.4', dst=dst_ip)
    udp = scapy.UDP(sport=10001, dport=10002)
    payload = ('hello' + '0123456789' * 200)[:pkt_size-len(eth/ip/udp)]
    pkt = eth/ip/udp/payload
    return bytes(pkt)

# Preparing the a couple of packets
def prepare_packet_group(ips):
        pkts_template = []
        for ip in ips:
                # ip_to_make = [init_ip, str(i)]
                # ip = ''.join(ip_to_make)
                pkts_template.append(gen_packet(ip))
        assert(pkts_template)
        return pkts_template

def load_ip_bag(rules):
        packs = []
        pack = []
	counter = 0
        for ip in rules:
		if counter < 16:
			counter += 1
			continue
                # gate = random.randint(0,total_sink)
                # table.load(ip=ip, gate=gate)
                # table.add(prefix=ip, prefix_len=32, gate=gate)
                pack.append(ip)
                if(len(pack) == 28):
                        packs.append(pack)
                        pack = []
		# if len(pack) > 4:
		#  	break
	if(len(packs) == 0 and len(pack) > 0):
		packs.append(pack)
        return packs

def load_ip_bag_repeat(rules):
        packs = []
        pack = []
	new_pack = []
        for ip in rules:
                # gate = random.randint(0,total_sink)
                # table.load(ip=ip, gate=gate)
                # table.add(prefix=ip, prefix_len=32, gate=gate)
                pack.append(ip)
                if(len(pack) == 28):
                        packs.append(pack)
                        pack = []
		if len(pack) > 16:
		  	break
	if(len(packs) == 0 and len(pack) > 0):
		packs.append(pack)

	# print(packs)
	# for i in packs:
