print(len(packs))
queue_idx = 0 # random.randint(0,8)
# assert(len(packs) < 8)
total_workers = 5
for i in range(total_workers):
	print("worker ", i)
	for pack in range(0, len(packs), len(packs)/total_workers):
		# print(packs[pack])
		pkts = prepare_packet_group(packs[pack])
		src = Source() 
		src -> Rewrite(templates=pkts) -> QueueOut(port=myport, qid=queue_idx) 
		src.attach_task(wid=i)
		queue_idx += 1
	# queue_idx %= 8
