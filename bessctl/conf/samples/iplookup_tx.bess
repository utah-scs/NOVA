        return packs

def load_rules(filename, rules):
        first_line = True
        count = 0
        with open(filename) as in_file:
           for line in in_file:
                if first_line or count < 4:
                        first_line = False
                        count += 1
                        continue

                line = line.split(" ")
                line = line[0].split("/")
                rules.append(line[0])
		# if count == 4:
		# 	return
                count += 1

def load_lpm_hashtable(table, rules):
        count = 0
        for ip in rules:
                print(count)
                count += 1
                gate = random.randint(0,total_sink)
                table.load(ip=ip, gate=gate)
                table.add(prefix=ip, prefix_len=32, gate=gate)

