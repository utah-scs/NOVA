# Server with multicore pipeline

import scapy.all as scapy
import socket
import os
import time

# PMD port ID
PMD_PORT_ID = 1

# Numbers of cores to use
NUM_CORES = int(os.environ['ncpu'])

# NUMA offset for CPU number
CPU_NUMA_OFFSET=0

# NUMA cpu organization
# Are cpus split across numa nodes in a range?
# Example: 0 - 7 Node 0 and 8 - 15 Node 1
CPU_NUMA_ORG = 'linear'
#
# Or cpus are split in even odd fashion
# Example: 0,2,4,6 to Node 0
# 1,3,5,7 to Node 1
# CPU_NUMA_ORG = 'even' or 'odd'
#CPU_NUMA_ORG = 'even'

for i in range(0, NUM_CORES):
    if CPU_NUMA_ORG == 'even':
        bess.add_worker(i, i * 2)
    elif CPU_NUMA_ORG == 'odd':
        bess.add_worker(i, (i * 2) + 1)
    else:
        bess.add_worker(i, i + CPU_NUMA_OFFSET)

pmdport::PMDPort(port_id=PMD_PORT_ID, num_inc_q=NUM_CORES, num_out_q=NUM_CORES)

# Create 8 rx queues for each core
queue_out = []
for i in range(0, NUM_CORES):
    queue_out.append(QueueOut(port=pmdport, qid=i))
    
# Create 8 tx queues for each core
queue_inc = []
for i in range(0, NUM_CORES):
    q_in = QueueInc(port=pmdport, qid=i)
    q_in.attach_task(wid=i)
    queue_inc.append(q_in)


# Match UDP destination port
ems = []
for i in range(0, NUM_CORES):
    em = ExactMatch(fields=[{'offset':36, 'num_bytes':2}])
    em.add(fields=[{'value_int':socket.htons(10002)}], gate=0)
    em.set_default_gate(gate=1)
    queue_inc[i] -> em
    ems.append(em)

for i in range(0, NUM_CORES):
    ems[i]:0 -> Crash() -> queue_out[i]
