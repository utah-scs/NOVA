# Server with multicore pipeline

import scapy.all as scapy
import socket
import os
import sys
import time

# PMD port ID
PMD_PORT_ID = 0

# Numbers of cores to use
NUM_CORES = int(os.environ['ncpu'])

# NUMA offset for CPU number
CPU_NUMA_OFFSET=0

# NUMA cpu organization
# Are cpus split across numa nodes in a range?
# Example: 0 - 7 Node 0 and 8 - 15 Node 1
# CPU_NUMA_ORG = 'linear'
#
# Or cpus are split in even odd fashion
# Example: 0,2,4,6 to Node 0
# 1,3,5,7 to Node 1
# CPU_NUMA_ORG = 'even' or 'odd'
CPU_NUMA_ORG = 'even'

# PCI address of the NIC
PCI_ADDR = '17:00.0'

# Memory access type:
#   0: Local memory access
#   1: DMA from host
MEM_TYPE = 0

# Data structure type:
# plain: No data structure
# llist: Linked list
# hashtable: Hashtable
STRUCTURE='hashtable'

# Destination port for all incoming requests
DST_PORT_GET_OP = 10002

# Destination port for mutating operations
DST_PORT_SET_OP = 31633

for i in range(0, NUM_CORES):
    if CPU_NUMA_ORG == 'even':
        bess.add_worker(i, i * 2)
    elif CPU_NUMA_ORG == 'odd':
        bess.add_worker(i, (i * 2) + 1)
    else:
        bess.add_worker(i, i + CPU_NUMA_OFFSET)

pmdport::PMDPort(port_id=PMD_PORT_ID, num_inc_q=NUM_CORES, num_out_q=NUM_CORES)

# Create 8 rx queues for each core
queue_out = []
for i in range(0, NUM_CORES):
    queue_out.append(QueueOut(port=pmdport, qid=i))
    
# Create 8 tx queues for each core
queue_inc = []
for i in range(0, NUM_CORES):
    q_in = QueueInc(port=pmdport, qid=i)
    q_in.attach_task(wid=i)
    queue_inc.append(q_in)


# Match UDP destination port
em_in = []
for i in range(0, NUM_CORES):
    em = ExactMatch(fields=[{'offset':36, 'num_bytes':2}])
    em.add(fields=[{'value_int':socket.htons(DST_PORT_GET_OP)}], gate=0)
    em.add(fields=[{'value_int':socket.htons(DST_PORT_SET_OP)}], gate=1)
    em.set_default_gate(gate=2)
    queue_inc[i] -> em
    em_in.append(em)

em_out = []
for i in range(0, NUM_CORES):
    em = ExactMatch(fields=[{'offset':34, 'num_bytes':2}])
    em.add(fields=[{'value_int':socket.htons(DST_PORT_GET_OP)}], gate=0)
    em.add(fields=[{'value_int':socket.htons(DST_PORT_SET_OP)}], gate=0)
    em.set_default_gate(gate=1)
    em_out.append(em)

if os.path.basename(os.environ['bpf_obj0']) == "bpf-get.o":
    get_obj = os.environ['bpf_obj0']
    set_obj = os.environ['bpf_obj1']
elif os.path.basename(os.environ['bpf_obj1']) == "bpf-get.o":
    get_obj = os.environ['bpf_obj1']
    set_obj = os.environ['bpf_obj0']
else:
    print("ERROR: MICA HT BPF file names should be bpf-get.c and bpf-set.c")
    sys.exit(1)

# Create UBPF and DMA pipeline
ubpf1 = []
ubpf2 = []
dma1 = []
dma2 = []

memory_init = True

for i in range(0, NUM_CORES):
    if os.environ['enable_jit'] == "True":
      ubpf1.append(UBPF(bpf_file_path=get_obj, bpf_enable_jit=True))
      ubpf2.append(UBPF(bpf_file_path=set_obj, bpf_enable_jit=True))
    else:
      ubpf1.append(UBPF(bpf_file_path=get_obj))
      ubpf2.append(UBPF(bpf_file_path=set_obj))

    if memory_init == True:
        print("CONFIG: Initializing memory")
        dma1.append(DMA(id = 1, size = 1024 * 1024 * 1024, memtype = MEM_TYPE, pci_addr=PCI_ADDR, structure=STRUCTURE, init=True))
        memory_init = False
    else:
        dma1.append(DMA(id = 1, size = 1024 * 1024 * 1024, memtype = MEM_TYPE, pci_addr=PCI_ADDR, structure=STRUCTURE))
    
    dma2.append(DMA(id = 1, size = 1024 * 1024 * 1024, memtype = MEM_TYPE, pci_addr=PCI_ADDR, structure=STRUCTURE))
    
for i in range(0, NUM_CORES):
    em_in[i]:0 -> ubpf1[i]
    ubpf1[i]:0 -> dma1[i] -> ubpf1[i]
    ubpf1[i]:1 -> em_out[i]

    em_in[i]:1 -> ubpf2[i]
    ubpf2[i]:0 -> dma2[i] -> ubpf2[i]
    ubpf2[i]:1 -> em_out[i]

    em_out[i]:0 -> queue_out[i]
