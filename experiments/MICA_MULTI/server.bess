import scapy.all as scapy
import socket
import os
import time

bess.add_worker(0, 1)

pmdport::PMDPort(port_id=0, num_inc_q=1, num_out_q=1)
server_out::QueueOut(port=pmdport, qid=0)
server_in::QueueInc(port=pmdport, qid=0)

# Match UDP destination port
# Tree output gates
# First two gates will send packets to two UBPF module based on port
# Third one sends all other packets to sink
em::ExactMatch(fields=[{'offset':36, 'num_bytes':2}])

# Initial pipeline
server_in -> ebpf_1

path = os.getcwd()
bpf_obj=os.environ['bpf_obj']

# Create a UBPF instance from BPF object file
if os.environ['enable_jit'] == "True":
  ebpf_1::UBPF(bpf_file_path='{}/CLIENT_REG_MULTINODE/{}'.format(path, bpf_obj), bpf_enable_jit=True)
else:
  ebpf_1::UBPF(bpf_file_path='{}/CLIENT_REG_MULTINODE/{}'.format(path, bpf_obj))

# DMA module for the first UBPF
dma_1::DMA(id = 1, size = 1024, memtype = 0)

ebpf_1:0 -> dma_1 -> ebpf_1
ebpf_1:1 -> server_out
